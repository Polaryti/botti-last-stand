config_version=5

[application]
config/name="Undead Drop"
config/description="Low-poly medieval zombie survival for phones."
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.035, 0.05, 0.1, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/splash.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=true

[autoload]
Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]
theme/custom_font="res://assets/fonts/Almendra-Bold.ttf"
theme/default_font_subpixel_positioning=0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.09, 1)
lights_and_shadows/directional_shadow/size=2048
mesh_lod/lod_change/threshold_pixels=4.0
